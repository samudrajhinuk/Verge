# Copy to .env.local and fill in your own value. Never commit .env.local.
#
# Postgres, hosted on Neon (https://neon.tech). A hosted database is required
# from the start: most hosts (Vercel included) give the app a read-only
# filesystem, so a local file-based database like SQLite cannot be written to
# in production.
DATABASE_URL="postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require"
