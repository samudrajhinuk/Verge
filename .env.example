# Copy to .env and adjust. Never commit .env.
#
# Local development uses a SQLite file. The path is resolved from the project
# root, so the database sits next to the migrations in prisma/.
DATABASE_URL="file:./prisma/dev.db"

# On a host with a read-only filesystem, SQLite cannot be written to.
# Point this at a hosted Postgres instead and change the `provider` line in
# prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://user:password@host:5432/verge?schema=public"
