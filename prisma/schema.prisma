// Verge — data model.
//
// Portability note: this schema avoids Prisma `enum` even though a few
// columns look like one (propertyType, city). Postgres supports enums, but
// keeping these as plain Strings — validated in application code against
// lib/property-options.ts — means the one list of allowed values stays in
// exactly one file instead of being duplicated into the schema too.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id String @id @default(cuid())

  // Human-readable and stable: this is the /properties/[slug] URL.
  slug String @unique

  name String
  // Neighbourhood shown under the name, e.g. "Bandra West".
  locality String
  // The coarse value the location filter matches on, e.g. "Mumbai".
  city     String

  // One of the values in PROPERTY_TYPES (lib/property-options.ts).
  propertyType String
  bedrooms     Int
  bathrooms    Int

  // Whole rupees. Formatted into lakh/crore at display time only.
  // Int tops out at ~214 crore, which is above anything residential we list.
  priceInr Int

  areaSqft   Int
  // e.g. "14th of 22" or "Ground". Null for villas and row houses.
  floor      String?
  // e.g. "North-East facing".
  facing     String
  // e.g. "Ready to move" or "December 2026".
  possession String

  description String

  // Local files under /public. Video is 9:16; poster is its first frame.
  videoUrl  String
  posterUrl String
  // Array of { time: "0:11", label: "Living room, west glazing" }, in the
  // order they appear in the video. Read as a whole, never queried into —
  // that's why this is Json and not its own table.
  shotList Json

  createdAt DateTime @default(now())

  enquiries Enquiry[]

  // Indexed because these are the two high-cardinality filter columns.
  // bedrooms and propertyType have too few distinct values to be worth an index.
  @@index([city])
  @@index([priceInr])
}

model Enquiry {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String
  message String?

  // Which property the enquiry came from — the whole point of the pipeline.
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([createdAt])
}
